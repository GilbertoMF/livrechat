# LivreChat Server Environment Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=livrechat_super_secret_jwt_key_2026_production_change_me

# PostgreSQL Connection (Optional: if omitted, defaults to built-in zero-config persistent local store)
# Example: postgresql://postgres:password@localhost:5432/livrechat
DATABASE_URL=

# Optional WebRTC TURN Server (STUN is enabled by default)
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=secret

# Optional Firebase Cloud Messaging for Push Notifications
# FIREBASE_SERVICE_ACCOUNT_KEY=./service-account.json
